{
  "permissions": {
    "deny": [
      "Read(./.hrz.env)",
      "Read(**/.hrz.env)",
      "Read(./.env)",
      "Read(**/.env)",
      "Edit(./.hrz.env)",
      "Read(~/Library/**)",
      "Read(~/Documents/**)",
      "Edit(~/Library/**)",
      "Edit(~/Documents/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_prompt.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_log_check.py\""
          }
        ]
      }
    ]
  }
}
